# =============================================================================
#  Environment configuration for the Digital Sari-Sari Store project.
#  Copy to ".env" and adjust. The .env file is gitignored.
# =============================================================================

# --- Database -----------------------------------------------------------------
# If DATABASE_URL is set, the pipeline connects to THAT PostgreSQL instance
# (Docker, local install, or a cloud DB — for dashboards & ML).
#   Example:  postgresql+psycopg://sarisari:sarisari@localhost:5432/sarisari
#
# If DATABASE_URL is left EMPTY, the loader falls back to a zero-setup local
# PostgreSQL managed by `pgserver` under ./.pgdata (great on WSL with no Docker).
DATABASE_URL=

# Directory for the local pgserver-managed instance (used only when DATABASE_URL is empty).
PGDATA_DIR=.pgdata

# --- Synthesis ----------------------------------------------------------------
# Approximate TOTAL number of rows to synthesize across ALL tables.
SARISARI_TARGET_ROWS=676767

# Master random seed — makes synthesis fully reproducible.
SARISARI_SEED=20110628

# Business history window (the store opened in 2011).
SARISARI_START_DATE=2011-01-01
SARISARI_END_DATE=2026-06-28

# Where generated CSVs are written.
SARISARI_CSV_DIR=data/csv
